<Window x:Class="MIAPR_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MIAPR_4"
        mc:Ignorable="d"
        Title="MIAPR_4" Height="600" Width="1200">
    <Grid Background="#f0f0f0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <!-- Блок с настройками -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" BorderBrush="#B0B0B0" Background="#D3D3D3" BorderThickness="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock FontSize="17" Padding="5" TextAlignment="Center" VerticalAlignment="Center" Background="#B0B0B0" FontFamily="Open Sans" Grid.Row="0" Margin="6" Grid.ColumnSpan="5">
                    Количество классов
                </TextBlock>
                <TextBox Name="TextBoxClassesNumber" Grid.Row="1" Grid.ColumnSpan="5" Margin="5"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         FontSize="14" Background="White" BorderBrush="#B0B0B0" Text="1"/>

                <TextBlock FontSize="17" Background="#B0B0B0" VerticalAlignment="Center" Padding="5" TextAlignment="Center" FontFamily="Open Sans" Grid.Row="2" Margin="6"
                           Grid.ColumnSpan="5">
                    Количество объектов в классе
                </TextBlock>
                <TextBox Name="TextBoxObjectNumber" Grid.Row="3" Grid.ColumnSpan="5" Margin="5"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         FontSize="14" Background="White" BorderBrush="#B0B0B0" Text="1"/>

                <TextBlock FontSize="17" Background="#B0B0B0" VerticalAlignment="Center" Padding="5" TextAlignment="Center" FontFamily="Open Sans" Grid.Row="4" Margin="6"
                           Grid.ColumnSpan="5">
                    Количество признаков объекта
                </TextBlock>
                <TextBox Name="TextBoxAttributeNumber" Grid.Row="5" Grid.ColumnSpan="5" Margin="5"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         FontSize="14" Background="White" BorderBrush="#B0B0B0" Text="1"/>

                <Button Name="ButtonCreateSelection" Background="#B0B0B0" Padding="5" Height="50" VerticalAlignment="Center" Grid.Row="6" Grid.ColumnSpan="5"
                        FontFamily="Open Sans" FontSize="15" Margin="7,7,7,7"
                        Click="ButtonCreateSelection_Click"> 
                    Создать обучающую выборку
                </Button>
            </Grid>
        </Border>

        <!-- Блок для классификации -->
        <Border Grid.Column="0" Grid.Row="2" Grid.RowSpan="2" BorderBrush="#B0B0B0" Background="#D3D3D3" BorderThickness="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="47*" />
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock FontSize="17" Background="#B0B0B0" VerticalAlignment="Center" Padding="5" TextAlignment="Center" FontFamily="Open Sans" Grid.Row="0" Margin="6,6,6,6"
                           Grid.ColumnSpan="2">
                    Классификация
                </TextBlock>
                <ScrollViewer Grid.Row="1" Grid.RowSpan="5" Grid.ColumnSpan="2">
                    <StackPanel Name="InputPanel" />
                </ScrollViewer>
                <Button Name="ButtonClassify" Background="#B0B0B0" VerticalAlignment="Center" Grid.Row="6" Grid.ColumnSpan="2" Margin="7,7,7,7" FontFamily="Open Sans"
                        FontSize="15" Click="ButtonClassify_Click">
                    Классифицировать
                </Button>
            </Grid>
        </Border>

        <!-- Правая панель с обучающей выборкой и решающими функциями -->
        <Border Background="White" BorderBrush="#B0B0B0" Name="RightBoxBorder" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="0" Grid.RowSpan="4"
                BorderThickness="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Border Name="UpperSideBox1" Grid.Column="0" Grid.Row="0"
                        BorderBrush="#B0B0B0" BorderThickness="3">
                    <TextBlock FontSize="20" TextAlignment="Center" FontFamily="Open Sans" Margin="15" >
                        Обучающая выборка
                    </TextBlock>
                </Border>
                <Border Name="UpperSideBox2" Grid.Column="1" Grid.Row="0"
                        BorderBrush="#B0B0B0" BorderThickness="3">
                    <TextBlock FontSize="20" TextAlignment="Center" FontFamily="Open Sans" Margin="15">
                        Решающие функции
                    </TextBlock>
                </Border>
                <Border Name="DownSideBox1" Grid.Column="0" Grid.Row="1"
                        BorderBrush="#B0B0B0" BorderThickness="3">
                    <ListView Name="ListViewSelection" Background="White" Grid.RowSpan="2" Grid.ColumnSpan="2">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Border>
                <Border Name="DownSideBox" Grid.Column="1" Grid.Row="1"
                        BorderBrush="#B0B0B0" BorderThickness="3">
                    <ListView Name="ListViewSolutions" Background="White" Grid.RowSpan="2" Grid.ColumnSpan="2">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
