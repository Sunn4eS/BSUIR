# Переменные окружения — Guitar Trainer
# ВАЖНО: не коммитить этот файл в git! Добавь .env в .gitignore

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=guitar_user
POSTGRES_PASSWORD=guitar_secret
POSTGRES_DB=guitar_trainer
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=4000
JWT_SECRET=supersecretjwtkey_CHANGE_ME_IN_PRODUCTION_min32chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
